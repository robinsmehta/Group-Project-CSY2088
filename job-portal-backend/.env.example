# ============================================================
# .env.example
#
# This file shows all the environment variables the app needs.
# DO NOT put real secrets here — this file is safe to commit.
#
# Usage:
#   1. Copy this file:   cp .env.example .env
#   2. Fill in your real values in .env
#   3. .env is listed in .gitignore and should NEVER be committed
# ============================================================

# --- Flask ---
# A long random string used to sign session cookies. Keep it secret!
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-very-secret-key-here

# --- Database ---
# Connection string format: mysql+pymysql://<user>:<password>@<host>/<database>
# Example for local MySQL: mysql+pymysql://root:password@localhost/job_portal_db
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=job_portal_db

# --- File Uploads ---
# Folder where uploaded résumé files will be saved (relative to project root)
UPLOAD_FOLDER=uploads

# --- Environment ---
# Set to "development" for debug mode, "production" for live server
FLASK_ENV=development
