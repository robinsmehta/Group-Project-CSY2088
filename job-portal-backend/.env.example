# ============================================================
# .env.example — Environment Variables Template
#
# This file lists all environment variables required by the application.
# Safe to commit to Git (contains NO real credentials or passwords).
#
# Usage Instructions:
#   1. Copy this file to create your local .env file:
#      cp .env.example .env
#   2. Open .env and replace placeholder values with your real MySQL password.
#   3. .env is in .gitignore and will NOT be tracked by Git.
# ============================================================

# --- Database Connection Settings ---
# DB_HOST: Address of MySQL server (use 'localhost' or '127.0.0.1' for local dev)
DB_HOST=localhost

# DB_PORT: Port number MySQL server listens on (default: 3306)
DB_PORT=3306

# DB_USER: MySQL database user (default local superuser: 'root')
DB_USER=root

# DB_PASSWORD: Password for your local MySQL user account
DB_PASSWORD=password

# DB_NAME: Target MySQL database name (run `CREATE DATABASE job_portal;` in MySQL)
DB_NAME=job_portal

# --- Flask Security ---
# SECRET_KEY: A secret key used by Flask for session cookie and CSRF signing.
# Generate a strong key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here

# --- Application Environment ---
# FLASK_ENV: "development" for local debugging & auto-reload, "production" for live server
FLASK_ENV=development

# --- File Uploads ---
# UPLOAD_FOLDER: Subdirectory where uploaded applicant resume files will be saved
UPLOAD_FOLDER=uploads
